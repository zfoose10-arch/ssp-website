{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|MultiEdit|NotebookEdit|Write|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "/Users/zanesigafoos/scripts/gate_hook.sh"
          }
        ]
      },
      {
        "matcher": "Read|Grep|Glob|Edit|MultiEdit|NotebookEdit|Write|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "/Users/zanesigafoos/scripts/rule_block_hook.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|MultiEdit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "/Users/zanesigafoos/scripts/writing_scan_hook.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/Users/zanesigafoos/scripts/prompt_marker_hook.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/Users/zanesigafoos/scripts/stop_ledger_hook.sh",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
